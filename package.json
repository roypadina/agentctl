{
  "name": "@roypadina/agentctl",
  "version": "0.12.1",
  "description": "Start and resume Claude Code & Codex sessions from one terminal menu — fuzzy-resume past sessions with transcript preview.",
  "type": "module",
  "license": "MIT",
  "author": "Roy Padina",
  "homepage": "https://github.com/roypadina/agentctl#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/roypadina/agentctl.git"
  },
  "bugs": "https://github.com/roypadina/agentctl/issues",
  "bin": {
    "agentctl": "bin/agentctl"
  },
  "files": [
    "dist",
    "bin",
    "config.example.toml",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "chalk": "^5.3.0",
    "commander": "^12.1.0",
    "ink": "^5.0.1",
    "ink-text-input": "^6.0.0",
    "react": "^18.3.1",
    "smol-toml": "^1.6.1"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "@types/react": "^18.3.0",
    "ink-testing-library": "^4.0.0",
    "tsup": "^8.3.0",
    "tsx": "^4.22.3",
    "typescript": "^5.5.0",
    "vitest": "^2.1.0"
  },
  "keywords": [
    "claude-code",
    "codex",
    "cli",
    "tui",
    "session-manager",
    "resume",
    "coding-agent",
    "ai-agent"
  ],
  "publishConfig": {
    "access": "public"
  }
}
